# Cloudflare Pages - HTTP headers
# Tai lieu: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Khong cache HTML (de cap nhat noi dung ngay khi deploy lai)
/index.html
  Cache-Control: no-cache

# PWA: service worker khong cache lau -> cap nhat kip khi deploy moi
/sw.js
  Cache-Control: no-cache

# PWA: manifest dung content-type + khong cache lau
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Cache lau cac file tinh (JS/CSS/anh doi ten khi sua thi tu het cache)
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
